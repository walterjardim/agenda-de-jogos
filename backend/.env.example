HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agenda_de_jogos
# Opcional. Use a conexão direta ou o pooler em modo sessão para migrations do Supabase.
# DIRECT_URL=postgresql://usuario:senha@host:5432/postgres?sslmode=require
# IDs de clientes OAuth aceitos, separados por vírgula se houver mais de um.
GOOGLE_CLIENT_IDS=123456789-exemplo.apps.googleusercontent.com
SESSION_TTL_HOURS=168
# Origens web autorizadas, separadas por vírgula e sem barra no final.
CORS_ORIGINS=http://localhost:8081
# Para cookies web, publique a API e o frontend na mesma origem HTTPS.
# WEB_SESSION_ORIGIN=https://agenda.example.com
