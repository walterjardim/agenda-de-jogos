generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  googleSub    String        @unique @map("google_sub")
  email        String
  name         String
  timezone     String        @default("America/Sao_Paulo")
  activeTeamId String?       @map("active_team_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  activeTeam   Team?         @relation("ActiveTeam", fields: [activeTeamId], references: [id], onDelete: SetNull)
  ownedTeams   Team[]        @relation("TeamOwner")
  follows      TeamFollow[]
  sessions     AuthSession[]

  @@index([activeTeamId])
  @@map("users")
}

model AuthSession {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_auth_sessions_user")
  @@map("auth_sessions")
}

model Team {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  name        String
  sport       String
  category    String
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  owner       User         @relation("TeamOwner", fields: [userId], references: [id], onDelete: Cascade)
  activeUsers User[]       @relation("ActiveTeam")
  followers   TeamFollow[]
  athletes    Athlete[]
  competitions Competition[]
  matches     Match[]
  uniformPieces UniformPiece[]

  @@map("teams")
}

model Competition {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId String @map("team_id") @db.Uuid
  name   String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  matches Match[]

  @@index([teamId, id])
  @@map("competitions")
}

model Athlete {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId      String @map("team_id") @db.Uuid
  name        String
  position    String
  shirtNumber Int    @map("shirt_number")
  status      String @default("active")
  team        Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  callups     Callup[]

  @@unique([teamId, shirtNumber])
  @@map("athletes")
}

model UniformPiece {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId        String  @map("team_id") @db.Uuid
  pieceType     String  @map("piece_type")
  uniformName   String  @map("uniform_name")
  description   String
  colorHex      String  @default("#000000") @map("color_hex")
  isHomeDefault Boolean @default(false) @map("is_home_default")
  isAwayDefault Boolean @default(false) @map("is_away_default")
  team          Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  shirts        Match[] @relation("MatchShirt")
  shorts        Match[] @relation("MatchShorts")
  socks         Match[] @relation("MatchSocks")

  @@index([teamId, id])
  @@map("uniform_pieces")
}

model Match {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId            String        @map("team_id") @db.Uuid
  competitionId     String?       @map("competition_id") @db.Uuid
  opponent          String
  startsAt          DateTime      @map("starts_at") @db.Timestamptz(3)
  location          String?
  notes             String?
  isHome            Boolean       @default(true) @map("is_home")
  shirtPieceId      String?       @map("shirt_piece_id") @db.Uuid
  shortsPieceId     String?       @map("shorts_piece_id") @db.Uuid
  socksPieceId      String?       @map("socks_piece_id") @db.Uuid
  refereeFeeCents   Int?          @map("referee_fee_cents")
  createKey         String?       @map("create_key")
  hasSavedCallup    Boolean       @default(false) @map("has_saved_callup")
  team              Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  competition       Competition? @relation(fields: [competitionId], references: [id], onDelete: SetNull)
  shirtPiece        UniformPiece? @relation("MatchShirt", fields: [shirtPieceId], references: [id], onDelete: SetNull)
  shortsPiece       UniformPiece? @relation("MatchShorts", fields: [shortsPieceId], references: [id], onDelete: SetNull)
  socksPiece        UniformPiece? @relation("MatchSocks", fields: [socksPieceId], references: [id], onDelete: SetNull)
  callups           Callup[]

  @@unique([teamId, createKey], map: "matches_team_id_create_key_key")
  @@index([teamId, startsAt, id], map: "idx_matches_team_date")
  @@map("matches")
}

model Callup {
  matchId   String  @map("match_id") @db.Uuid
  athleteId String  @map("athlete_id") @db.Uuid
  match     Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  athlete   Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@id([matchId, athleteId])
  @@index([athleteId])
  @@map("callups")
}

model TeamFollow {
  userId    String   @map("user_id") @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([userId, teamId])
  @@index([teamId], map: "idx_team_follows_team")
  @@map("team_follows")
}
